{
  "name": "outdoor-race-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preflight": "node scripts/verify_site_preflight.mjs",
    "build": "node scripts/verify_site_preflight.mjs && tsc && vite build && node scripts/generate_seo.mjs",
    "preview": "vite preview",
    "auto-update": "node scripts/auto_update.mjs",
    "sync:portals": "node scripts/sync_external_portals.mjs",
    "check:duplicates": "node scripts/audit-duplicates.mjs",
    "fix:duplicates": "node scripts/audit-duplicates.mjs --fix",
    "check:links": "node scripts/verify-links.mjs",
    "heal:links": "node scripts/heal-links.mjs",
    "geocode:events": "node scripts/geocode_events.mjs",
    "promo:video": "node scripts/generate_promo_video.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.23",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
